{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AviBackToBlack/windows-no-bullshit-audit/schemas/audit-state.schema.json",
  "title": "Windows No-Bullshit Audit State",
  "description": "Generated by scripts/assemble-report.ps1 from findings/*.json. Do not hand-write.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "phase",
    "target_attestation",
    "findings",
    "pending_approvals",
    "remediations"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "run_id": { "type": "string" },
    "phase": {
      "enum": [
        "TARGET_ATTESTATION",
        "BASELINE_COLLECTION",
        "TRIAGE",
        "TARGETED_INVESTIGATION",
        "CURRENT_WEB_RESEARCH",
        "REMEDIATION_PLANNING",
        "REMEDIATION",
        "POST_REPAIR_VERIFICATION",
        "SOFTWARE_HYGIENE",
        "FINAL_VALIDATION",
        "COMPLETE"
      ]
    },
    "computer": { "type": ["string", "null"] },
    "windows": { "type": ["object", "null"] },
    "started_at": { "type": ["string", "null"] },
    "updated_at": { "type": ["string", "null"] },
    "preflight_confirmed": { "type": "boolean" },
    "counts": {
      "type": "object",
      "description": "Initial and final finding counts per state.",
      "properties": {
        "initial": { "type": "object" },
        "final": { "type": "object" }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "pending_approvals": {
      "type": "array",
      "items": { "$ref": "#/$defs/approval" }
    },
    "remediations": {
      "type": "array",
      "items": { "$ref": "#/$defs/remediation" }
    },
    "checkpoints": {
      "type": "array",
      "items": { "type": "object" }
    },
    "target_attestation": { "$ref": "#/$defs/attestation" }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "domain", "title", "state", "confidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "state": { "enum": ["healthy", "observe", "action", "critical", "historical"] },
        "initial_state": { "enum": ["healthy", "observe", "action", "critical", "historical"] },
        "confidence": { "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"] },
        "local_evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "lifecycle_context": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "external_evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "conclusion": { "type": "string", "minLength": 1 },
        "recommended_action": { "type": "string", "minLength": 1 },
        "approval": { "type": "string", "minLength": 1 },
        "verification": { "type": "string", "minLength": 1 },
        "remaining_uncertainty": { "type": "string", "minLength": 1 },
        "budget_note": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "$comment": "An open finding must carry a next step, otherwise the audit can end with unresolved items presented as complete.",
          "if": { "properties": { "state": { "enum": ["action", "critical"] } }, "required": ["state"] },
          "then": { "anyOf": [{ "required": ["recommended_action"] }, { "required": ["remaining_uncertainty"] }] }
        },
        {
          "$comment": "UNKNOWN is valid only when the next discriminating test is named.",
          "if": { "properties": { "confidence": { "const": "UNKNOWN" } }, "required": ["confidence"] },
          "then": { "required": ["remaining_uncertainty"] }
        }
      ]
    },
    "approval": {
      "type": "object",
      "required": ["id", "action", "reason", "risk", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "risk": { "enum": ["low", "medium", "high"] },
        "rollback": { "type": "string", "minLength": 1 },
        "finding_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pending", "approved", "denied", "withdrawn"] }
      }
    },
    "remediation": {
      "type": "object",
      "required": ["timestamp", "finding_id", "action", "result"],
      "properties": {
        "timestamp": { "type": "string", "minLength": 1 },
        "finding_id": { "type": "string", "minLength": 1 },
        "before": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "approval_id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "result": { "type": "string", "minLength": 1 },
        "exit_code": { "type": ["integer", "null"] },
        "verification": { "type": "string", "minLength": 1 },
        "rollback": { "type": "string", "minLength": 1 }
      }
    },
    "attestation": {
      "type": "object",
      "required": ["locality_status", "operator_confirmed"],
      "properties": {
        "locality_status": { "enum": ["CONFIRMED_TARGET", "NOT_TARGET", "UNCONFIRMED", "UNAVAILABLE"] },
        "operator_confirmed": { "type": "boolean" },
        "computer_name": { "type": ["string", "null"] },
        "os_caption": { "type": ["string", "null"] },
        "os_build": { "type": ["string", "null"] },
        "edition_id": { "type": ["string", "null"] },
        "os_architecture": { "type": ["string", "null"] },
        "manufacturer": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "system_drive": { "type": ["string", "null"] },
        "likely_virtualized": { "type": ["boolean", "null"] },
        "is_elevated": { "type": ["boolean", "null"] },
        "evidence_source": { "type": ["string", "null"] }
      }
    }
  }
}
